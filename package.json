{
  "name": "@francescoli/dsh-quota",
  "version": "0.5.0-secure.1",
  "engines": { "node": ">=24", "dsh": ">=0.2.2-alpha.2" },
  "description": "Harness-native token usage by task, hour, day, model and provider, with credential-safe official account quotas and balances",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-locale"],
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Francesco502/dsh-quota.git"
  },
  "bugs": {
    "url": "https://github.com/Francesco502/dsh-quota/issues"
  },
  "homepage": "https://github.com/Francesco502/dsh-quota#readme",
  "author": "Francesco502",
  "scripts": {
    "build:host": "node bundle-host.mjs",
    "build:client": "node bundle-client.mjs",
    "build": "node bundle-host.mjs && node bundle-client.mjs",
    "prepack": "node bundle-host.mjs && node bundle-client.mjs",
    "test": "node bundle-host.mjs && node bundle-client.mjs && node --test tests/*.test.mjs",
    "validate:release": "pwsh -File .github/scripts/validate-release.ps1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "token-meter",
    "cursor",
    "codex",
    "openai",
    "antigravity",
    "opencode-go"
  ],
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "license": "Apache-2.0"
}
